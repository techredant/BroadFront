# Copy to .env and fill in. Anything prefixed with EXPO_PUBLIC_ is bundled
# into the client and safe to read at runtime via process.env.*.

# Stream Chat (chat + livestreams)
EXPO_PUBLIC_STREAM_API_KEY=
STREAM_SECRET_KEY=

# Clerk auth
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Cloudinary delivery — used by buildCloudinaryUrl() in src/utils/mediaUtils.ts
# to route both new uploads (res.cloudinary.com/.../image|video/upload/...) and
# legacy /api/media/<id> URLs through Cloudinary's CDN with f_auto,q_auto.
# When unset, buildCloudinaryUrl is a graceful no-op (returns resolveMediaUrl
# unchanged) so local dev still works.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Hosted API (REST only — Socket.IO live feed does NOT work on Vercel)
EXPO_PUBLIC_API_URL=https://cast-api-zeta.vercel.app

# Live feed (Socket.IO) — point at a local Node backend on your machine
EXPO_PUBLIC_USE_LOCAL_API=false
# Fallback if Metro host is unavailable (optional — Metro IP is preferred):
# EXPO_PUBLIC_API_URL_DEV=http://192.168.1.10:3000
# USB cable on Android: `adb reverse tcp:3000 tcp:3000` then uncomment:
# EXPO_PUBLIC_USE_USB_API=true

# Optional override for the Socket.IO server (defaults to API_PUBLIC_URL)
# EXPO_PUBLIC_SOCKET_URL=

# OpenAI (server-side only — not bundled into the client)
OPENAI_API_KEY=
